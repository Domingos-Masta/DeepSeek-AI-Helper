<idea-plugin>
    <!-- Java-plugin-specific extension points — loaded only when com.intellij.java is present -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Java code completion (static-analysis pre-filtering + annotation/comment awareness) -->
        <completion.contributor
            language="JAVA"
            implementationClass="com.deepseek.plugin.completion.JavaCompletionContributor"
            order="first"/>
    </extensions>
</idea-plugin>
